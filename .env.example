# Bluesky account to watch (default: kmanriffs.bsky.social)
BSKY_HANDLE=kmanriffs.bsky.social

# Poll interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# CallMeBot WhatsApp API (PRIMARY) — leave blank to run in dry-run mode
# Setup: message the CallMeBot WhatsApp number with the allow phrase (see README)
# CALLMEBOT_PHONE = YOUR WhatsApp number, digits only (e.g. 5511999999999)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Optional Telegram Bot API (secondary) — only used if both are set
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: path for persisted last-seen post URI (default: ./data/state.json)
# STATE_FILE=./data/state.json
