# Bluesky account to watch
BSKY_HANDLE=kmanriffs.bsky.social

# Poll interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# CallMeBot WhatsApp (PRIMARY for NEW inserts after first seed/backfill)
# Leave blank for dry-run (logs would-send only)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Optional SQLite path (default: ./data/releases.db)
# Local: DATABASE_PATH=./data/releases.db
# Fly / Docker: DATABASE_PATH=/data/releases.db  (set in fly.toml / Dockerfile)

# Public host (REQUIRED on Fly): long random string so strangers can't POST /api/poll.
# Background poller still runs. Manual Poll buttons hide when this is set.
# POLL_SECRET=

# Capacitor / native Android shell — set AFTER Fly deploy succeeds (real HTTPS URL)
# CAPACITOR_SERVER_URL=https://<your-app>.fly.dev
# NEXT_PUBLIC_APP_URL=https://<your-app>.fly.dev


