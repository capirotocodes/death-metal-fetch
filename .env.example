# Used only when running `npm run poll` locally. In production these come from
# GitHub repository secrets, read by .github/workflows/poll-and-deploy.yml.

# Bluesky account to watch (optional)
BSKY_HANDLE=kmanriffs.bsky.social

# CallMeBot WhatsApp. Leave blank for dry-run (logs only).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Where the archive lives (default: data/releases.json)
# ARCHIVE_PATH=data/releases.json
