# Bluesky account to watch (default: kmanriffs.bsky.social)
BSKY_HANDLE=kmanriffs.bsky.social

# Poll interval in milliseconds (default: 120000 = 2 minutes)
POLL_INTERVAL_MS=120000

# CallMeBot WhatsApp API — leave blank to run in dry-run mode
# Phone: international format, e.g. 34644664570 (no + or spaces)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Optional: path for persisted last-seen post URI (default: ./data/state.json)
# STATE_FILE=./data/state.json
